# === Yandex Fleet API ===
# Берутся в личном кабинете fleet.yandex.kz -> Настройки -> API
YANDEX_CLIENT_ID=
YANDEX_API_KEY=
YANDEX_PARK_ID=

# Регион API-хоста. Для большинства партнёров СНГ/КЗ актуален этот адрес,
# но ОБЯЗАТЕЛЬНО сверьте в вашей документации API (ссылка приходит вместе
# с ключом в личном кабинете) — у части парков хост отличается.
YANDEX_API_BASE=https://fleet-api.taxi.yandex.net

# === Опционально: для "умного" разбора вопросов на естественном языке ===
# Если оставить пустым — чат будет работать на встроенных правилах
# (ключевые слова), без LLM.
ANTHROPIC_API_KEY=

# === Сервер ===
PORT=3001
# Сколько минут кэшировать данные из Yandex, чтобы не дёргать API на каждый вопрос
CACHE_MINUTES=10
